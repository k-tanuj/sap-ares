# ==========================================
# ARES Backend Environment Configuration
# ==========================================

# Database Configuration
# Local SQLite default: sqlite:///./ares.db
# SAP HANA Cloud: hana+hdbcli://<user>:<password>@<host>:<port>/?schema=ARES&encrypt=true&sslValidateCertificate=false
DATABASE_URL=sqlite:///./ares.db

# Database Connection Pooling (Production / SAP HANA)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Trade Intelligence (USITC DataWeb API)
USITC_API_BASE_URL=https://datawebws.usitc.gov/dataweb
USITC_API_KEY=your_usitc_dataweb_api_key

# Generative AI & Autonomous Agent (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key

# SAP Business Technology Platform (BTP) & S/4HANA
USE_MOCK_SAP=false
SAP_API_KEY=your_sap_business_accelerator_hub_api_key
SAP_HUB_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap
SAP_INTEGRATION_URL=https://your-cpi-tenant.it-cpi012-rt.cfapps.eu10.hana.ondemand.com/http/ares/v1/trade-events
SAP_ANALYTICS_URL=https://your-sac-tenant.eu10.hcs.cloud.sap/api/v1/data
